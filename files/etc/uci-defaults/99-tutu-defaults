# ============================================================
# 网络 — FTTR 主路由模式
# LAN: br-lan / eth0 eth1 / 192.168.5.1
# WAN: eth2 / 192.168.1.2 / gateway 192.168.1.1
# ============================================================
uci set network.globals.packet_steering='1'
uci set network.globals.ula_prefix='fd38:3475:d56d::/48'

BR_SECTION="$(find_uci_section network device name br-lan)"
if [ -z "$BR_SECTION" ]; then
    uci set network.brlan='device'
    uci set network.brlan.name='br-lan'
    BR_SECTION='brlan'
fi
uci set network."$BR_SECTION".type='bridge'
uci set network."$BR_SECTION".ipv6='0'
uci -q delete network."$BR_SECTION".ports
uci add_list network."$BR_SECTION".ports='eth0'
uci add_list network."$BR_SECTION".ports='eth1'

uci set network.lan.proto='static'
uci set network.lan.device='br-lan'
uci set network.lan.ipaddr='192.168.5.1'
uci set network.lan.netmask='255.255.255.0'
uci -q delete network.lan.ip6assign

for device in eth0 eth1 eth2 eth3 eth4; do
    DEVICE_SECTION="$(find_uci_section network device name "$device")"
    if [ -z "$DEVICE_SECTION" ]; then
        uci set network."$device"='device'
        uci set network."$device".name="$device"
        DEVICE_SECTION="$device"
    fi
    if [ "$device" = 'eth4' ]; then
        uci set network."$DEVICE_SECTION".ipv6='0'
    fi
done

uci set network.wan.proto='static'
uci set network.wan.device='eth2'
uci set network.wan.force_link='0'
uci set network.wan.ipaddr='192.168.1.2'
uci set network.wan.netmask='255.255.255.0'
uci set network.wan.gateway='192.168.1.1'
