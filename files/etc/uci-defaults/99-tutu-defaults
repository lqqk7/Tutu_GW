#!/bin/sh
# 99-tutu-defaults — 首次启动自动执行，配置完成后自动删除

find_uci_section() {
    local package="$1"
    local type="$2"
    local option="$3"
    local value="$4"
    local section

    for section in $(uci show "$package" 2>/dev/null | sed -n "s/^${package}\.\([^=]*\)=${type}$/\1/p"); do
        if [ "$(uci -q get "${package}.${section}.${option}")" = "$value" ]; then
            echo "$section"
            return 0
        fi
    done
    return 1
}

set_redirect() {
    local section="$1"
    local name="$2"
    local proto="$3"
    local src_dport="$4"
    local dest_zone="$5"
    local dest_ip="$6"
    local dest_port="$7"

    uci -q delete firewall."$section"
    uci set firewall."$section"='redirect'
    uci set firewall."$section".name="$name"
    uci set firewall."$section".family='ipv4'
    uci set firewall."$section".proto="$proto"
    uci set firewall."$section".src='wan'
    uci set firewall."$section".src_dport="$src_dport"
    uci set firewall."$section".dest="$dest_zone"
    uci set firewall."$section".dest_ip="$dest_ip"
    uci set firewall."$section".dest_port="$dest_port"
    uci set firewall."$section".target='DNAT'
}

