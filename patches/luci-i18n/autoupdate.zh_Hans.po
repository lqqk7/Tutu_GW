msgstr "点击下方按钮升级到最新版本。请耐心等待路由器重启。"

msgid "Local firmware version:"
msgstr "本地固件版本："

msgid "Cloud firmware version:"
msgstr "云端固件版本："

msgid "Equipment name:"
msgstr "设备名称："

msgid "Kernel version:"
msgstr "内核版本："

msgid "Firmware type:"
msgstr "固件类型："

msgid "Error: Could not fetch cloud version information"
msgstr "错误：无法获取云端版本信息"

msgid "Start Upgrade"
msgstr "开始升级"

msgid "Upgrade started successfully! Router will reboot soon."
msgstr "升级已成功启动，路由器即将重启。"

msgid "Upgrade failed! Check /tmp/autoupdate.log for details."
msgstr "升级失败！详情请查看 /tmp/autoupdate.log。"

msgid "Upgrade failed!"
msgstr "升级失败！"

msgid "Check update script failed!"
msgstr "更新检查脚本执行失败！"

msgid "Check update failed"
msgstr "更新检查失败"
