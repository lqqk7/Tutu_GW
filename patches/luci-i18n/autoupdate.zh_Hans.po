msgid "Enable AutoUpdate"
msgstr "启用自动更新"

msgid "Automatically update firmware during the specified time"
msgstr "在指定时间自动更新固件。"

msgid "Week Day"
msgstr "执行日期"

msgid "Everyday"
msgstr "每天"

msgid "Sunday"
msgstr "星期日"

msgid "Monday"
msgstr "星期一"

msgid "Tuesday"
msgstr "星期二"

msgid "Wednesday"
msgstr "星期三"

msgid "Thursday"
msgstr "星期四"

msgid "Friday"
msgstr "星期五"

msgid "Saturday"
msgstr "星期六"

msgid "Fixed Hour"
msgstr "执行小时"

msgid "Fixed Minute"
msgstr "执行分钟"

msgid "GitHub URL"
msgstr "GitHub 地址"

msgid "Use GitHub API"
msgstr "使用 GitHub API"

msgid "Use GitHub API directly instead of zzz_api file. Recommended for custom repositories."
msgstr "直接使用 GitHub API，不使用 zzz_api 文件。建议自定义仓库使用此方式。"

msgid "GitHub Proxy"
msgstr "GitHub 代理"

msgid "Release Download Path"
msgstr "发布版下载路径"

msgid "Source"
msgstr "来源"

msgid "LuCI Edition"
msgstr "LuCI 版本"

msgid "Firmware Version"
msgstr "固件版本"

msgid "Target Board"
msgstr "目标平台"

msgid "Device Model"
msgstr "设备型号"

msgid "Firmware Suffix"
msgstr "固件后缀"

